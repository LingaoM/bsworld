config BR2_PACKAGE_BSWORLD_NIMBLE_LINUX
	bool "Apache NimBLE Linux example"
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_HAS_THREADS
	select BR2_PACKAGE_MBEDTLS
	help
	  Build the upstream Apache NimBLE Linux example as a Host-only
	  Application. It opens a Linux HCI device through HCI User Channel.

comment "Apache NimBLE Linux example needs a toolchain with C++ and threads"
	depends on !BR2_INSTALL_LIBSTDCPP || !BR2_TOOLCHAIN_HAS_THREADS
