config BR2_PACKAGE_BSWORLD_TROUBLE_LINUX
	bool "TrouBLE Linux example"
	depends on BR2_PACKAGE_HOST_RUSTC_TARGET_ARCH_SUPPORTS
	select BR2_PACKAGE_HOST_RUSTC
	help
	  Build the upstream TrouBLE Battery Service peripheral example for
	  Linux. It opens a Linux HCI device through HCI User Channel.

comment "TrouBLE Linux example needs a Rust-supported target architecture"
	depends on !BR2_PACKAGE_HOST_RUSTC_TARGET_ARCH_SUPPORTS
