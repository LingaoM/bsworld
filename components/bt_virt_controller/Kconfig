mainmenu "Bluetooth HCI Unix Socket sample"

source "Kconfig.zephyr"

config HCI_VIRT_IRQ
	int "HCI host transport IRQ"
	default 30
	help
	  Simulated IRQ used to wake the Zephyr-side HCI receive thread.
	  For nRF52 bsim this defaults to IRQ 30, which is reserved in the
	  SoC IRQ table but valid in the bsim interrupt controller. Do not use
	  SWI5_EGU5_IRQn/25 here because MPSL uses it as CONFIG_MPSL_LOW_PRIO_IRQN.

config HCI_VIRT_IRQ_PRIORITY
	int "HCI host transport IRQ priority"
	default 2
	help
	  Priority for the simulated interrupt used to wake the Zephyr-side
	  HCI receive thread when host transport input is available.
